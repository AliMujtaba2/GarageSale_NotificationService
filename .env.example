# Environment Configuration for GarageSale Notification Server

# Server Configuration
NODE_ENV=production
PORT=3000

# Firebase Service Account (for Vercel deployment)
# Copy the ENTIRE content of your serviceAccountKey.json file as a single line
# In Vercel, add this as an environment variable
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# CORS Settings (optional)
# ALLOWED_ORIGINS=https://your-frontend-domain.com

# Logging
LOG_LEVEL=info
